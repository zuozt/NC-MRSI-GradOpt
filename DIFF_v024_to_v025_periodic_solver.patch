 function ktraj = make_periodic_rosette_2d(params)
-%MAKE_PERIODIC_ROSETTE_2D Generate one closed rosette period for MRSI.
-%
-% Unlike an arbitrary long readout, this returns one compact period. The
-% samples include a closed endpoint so that k(1) and k(end) coincide. In the
-% full MRSI readout this compact period is repeated Nspec times.
+%MAKE_PERIODIC_ROSETTE_2D Generate ONE compact 2D rosette period for MRSI.
+% Returns Npp unique samples over [0,Tperiod), without duplicated endpoint.
+% Default shape uses q(u)=sin(pi*u)^2 to avoid the signed-sine two-lobe
+% appearance when the user intends one spatial period.
 
 Npp = getp(params, 'Npp', getp(params, 'N', 96));
 Kmax = getp(params, 'Kmax', 25);
 nRadial = getp(params, 'nRadial', 1);
 nAngular = getp(params, 'nAngular', 1);
 phase = getp(params, 'phase', 0);
+shape = getp(params, 'shape', 'smooth_petal');
+
+Npp = round(Npp);
+if Npp < 4
+    error('Npp must be at least 4 for a periodic rosette period.');
+end
+
+u = (0:Npp-1).' / Npp;
+switch lower(shape)
+    case {'smooth_petal','sin2','sin_squared'}
+        q = Kmax * sin(pi*nRadial*u).^2;
+    case {'signed_sine','paper_signed'}
+        q = Kmax * sin(2*pi*nRadial*u);
